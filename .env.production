# ──────────────────────────────────────────────────────────────────────────────
#  AuctionSphere — Backend Environment Variables
#  Fill in all values below, then add this file to Render → Environment
# ──────────────────────────────────────────────────────────────────────────────

# ── Database (Neon PostgreSQL) ─────────────────────────────────────────────────
# Get from: https://neon.tech → your project → Connection string
# IMPORTANT: change postgresql:// → postgresql+asyncpg:// and add ?ssl=require
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?ssl=require

# ── JWT Auth ───────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-super-secret-jwt-key-replace-this
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# ── Stripe Payments ────────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# Get after registering webhook on Render URL in Stripe Dashboard
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
# Replace YOUR-APP with your actual Vercel domain
STRIPE_SUCCESS_URL=https://YOUR-APP.vercel.app/payment/success
STRIPE_CANCEL_URL=https://YOUR-APP.vercel.app/payment/cancel

# ── Cloudinary Image Uploads ───────────────────────────────────────────────────
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── App ────────────────────────────────────────────────────────────────────────
# Replace YOUR-APP with your actual Vercel domain (no trailing slash)
FRONTEND_URL=https://YOUR-APP.vercel.app
ENVIRONMENT=production
